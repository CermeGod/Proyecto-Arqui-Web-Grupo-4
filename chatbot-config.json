{
  "chatbotConfig": {
    "apiName": "Inmovision Chatbot with Mistral AI",
    "version": "1.0",
    "baseUrl": "http://localhost:8080",
    "status": "ready-for-testing",
    "documentation": {
      "swagger": "http://localhost:8080/swagger-ui.html",
      "readmeFile": "INSTRUCCIONES_INTELLIJ.md",
      "architectureFile": "ARQUITECTURA.md"
    },
    "endpoints": [
      {
        "name": "Chatbot Ping",
        "method": "GET",
        "path": "/api/v1/chatbot/ping",
        "description": "Verificar que el chatbot está activo",
        "authentication": false,
        "expectedResponse": "Chatbot de Inmovision está activo ✓"
      },
      {
        "name": "Consultar Chatbot",
        "method": "POST",
        "path": "/api/v1/chatbot/consultar",
        "description": "Enviar una pregunta al chatbot",
        "authentication": false,
        "contentType": "application/json",
        "requestBody": {
          "mensaje": "¿Qué propiedades tienes?",
          "contexto": "El usuario busca apartamentos"
        },
        "expectedResponse": {
          "respuesta": "string - Respuesta del chatbot",
          "timestamp": "string - Hora de la respuesta",
          "exito": "boolean - Si fue exitosa",
          "mensaje": "string - Mensaje de estado"
        }
      }
    ],
    "environment": {
      "variables": [
        {
          "name": "MISTRAL_API_KEY",
          "required": true,
          "description": "API Key de Mistral AI",
          "value": "sk-xxxxxxxxxxxx"
        },
        {
          "name": "MISTRAL_MODEL",
          "required": false,
          "description": "Modelo de Mistral a usar",
          "default": "mistral-small-latest",
          "alternatives": [
            "mistral-medium-latest",
            "mistral-large-latest"
          ]
        }
      ]
    },
    "testCases": [
      {
        "name": "Test Ping",
        "endpoint": "/api/v1/chatbot/ping",
        "method": "GET",
        "expectedStatus": 200,
        "description": "Verificar que el servidor está corriendo"
      },
      {
        "name": "Test Consulta Simple",
        "endpoint": "/api/v1/chatbot/consultar",
        "method": "POST",
        "payload": {
          "mensaje": "Hola, ¿cómo estás?",
          "contexto": ""
        },
        "expectedStatus": 200,
        "expectedFields": ["respuesta", "timestamp", "exito", "mensaje"]
      },
      {
        "name": "Test Consulta con Contexto",
        "endpoint": "/api/v1/chatbot/consultar",
        "method": "POST",
        "payload": {
          "mensaje": "¿Qué propiedades tienes?",
          "contexto": "Cliente buscando apartamentos de 2 habitaciones en Lima"
        },
        "expectedStatus": 200,
        "expectedFields": ["respuesta", "timestamp", "exito", "mensaje"]
      },
      {
        "name": "Test Mensaje Vacío (Error Esperado)",
        "endpoint": "/api/v1/chatbot/consultar",
        "method": "POST",
        "payload": {
          "mensaje": "",
          "contexto": ""
        },
        "expectedStatus": 400,
        "expectedMessage": "El mensaje no puede estar vacío"
      }
    ],
